# URL pública del sitio (en producción usar https://tudominio.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# SUPABASE (Opcional al inicio: sin esto funciona en Modo Local)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# SEGURIDAD DEL DASHBOARD OCULTO (/adminfacu)
# ==========================================
# Emails autorizados separados por coma (ej: facu@marvelousgaming.com,vos@tuemail.com)
ADMIN_ALLOWED_EMAILS=facu@marvelousgaming.com,admin@marvelousgaming.com
# Contraseña para acceso en Modo Local (en producción usar Supabase Auth)
LOCAL_ADMIN_PASSWORD=marvelous2026
# Secreto largo aleatorio para firmar cookies de sesión admin
ADMIN_SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# ==========================================
# MERCADO PAGO (Checkout Pro + Webhook)
# ==========================================
MERCADOPAGO_ACCESS_TOKEN=
